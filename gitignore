# ============================================================================
# universal-skeleton repo — root .gitignore
# Covers: Next.js app + the npm package inside download/universal-skeleton
# ============================================================================

# ── Dependencies (any level: root app AND download/universal-skeleton) ──
node_modules/
.pnp
.pnp.*

# ── Next.js build output ──
/.next/
/out/
/build

# ── Library build output (regenerated by `npm run build` in the package) ──
# NOTE: git ignores it, but npm publish STILL ships it — `prepublishOnly`
# rebuilds dist/ before every publish.
download/universal-skeleton/dist/

# ── Packaged zip (regenerable artifact — don't bloat git history with it) ──
download/universal-skeleton.zip

# ── Testing ──
coverage/

# ── Environment files & secrets — NEVER commit these ──
.env
.env.*
!.env.example

# ── Local databases (schema lives in prisma/schema.prisma) ──
db/*.db
db/*.sqlite
*.db-journal

# ── Logs ──
*.log
dev.log
server.log
logs/

# ── TypeScript ──
*.tsbuildinfo
next-env.d.ts

# ── OS junk ──
.DS_Store
Thumbs.db
desktop.ini

# ── Editors ──
.idea/
.vscode/*
!.vscode/extensions.json

# ── Deploy targets ──
.vercel

# ── Sandbox / session tooling artifacts (delete these lines if you keep
#    any of these folders as real project folders) ──
.claude/
.z-ai-config
tool-results/
/skills/
/upload/
/scripts/
local-*
Caddyfile
