{
  "name": "universal-skeleton",
  "version": "1.0.0",
  "description": "Framework-agnostic skeleton loader that auto-generates shimmer or pulse skeletons from your real UI. Zero dependencies. Works with plain JS via CDN, React, Vue, Angular, Svelte, Web Components — any JS or TS project.",
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.iife.min.js",
  "jsdelivr": "dist/index.iife.min.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.iife.min.js"
    },
    "./css": "./dist/universal-skeleton.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "npx --yes serve demo",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "skeleton",
    "skeleton-loader",
    "skeleton-screen",
    "loading",
    "placeholder",
    "shimmer",
    "pulse",
    "spinner",
    "web-component",
    "custom-element",
    "react",
    "vue",
    "angular",
    "svelte",
    "nextjs",
    "framework-agnostic",
    "cdn",
    "umd",
    "zero-dependency",
    "auto"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=16"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.1",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/universal-skeleton.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/universal-skeleton/issues"
  },
  "homepage": "https://github.com/your-username/universal-skeleton#readme"
}
